# ==============================================================================
# AI Investment Research & Portfolio Guidance Agent - Environment Variables
# ==============================================================================

# Application Environment
APP_NAME="AI Investment Research & Portfolio Guidance Agent"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Model Routing & Dynamic LLM Configuration
# Supported providers: openai, gemini, anthropic, groq, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
MAX_DAILY_LLM_COST_USD=5.0

# Tier-Specific Routing
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o

CHEAP_LLM_PROVIDER=groq
CHEAP_LLM_MODEL=llama-3.3-70b-versatile

REASONING_LLM_PROVIDER=anthropic
REASONING_LLM_MODEL=claude-3-7-sonnet-20250219

LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=llama3.2

FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.0-flash

# Provider API Keys & Base URLs
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=investment_agent
# Optional explicit override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investment_agent

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional explicit override:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Observability (LangSmith Tracing)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investment-agent

# ------------------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# INDstocks (INDmoney broker) — prices, history, holdings. Read-only.
# Docs: https://api-docs.indstocks.com
# Generate a token at https://www.indstocks.com/app/api-trading/access-tokens
# Either set INDSTOCKS_ACCESS_TOKEN (expires in 24 hours) or set the three
# TOTP fields so the server can call POST /generate/token.
# ------------------------------------------------------------------------------
INDSTOCKS_BASE_URL=https://api.indstocks.com
INDSTOCKS_ACCESS_TOKEN=
INDSTOCKS_CLIENT_ID=A2wq16mS3QkPiuPRWlr5
INDSTOCKS_MPIN=0403
INDSTOCKS_TOTP_SECRET=Q25SA4FLZJLKWC4MYCXS35TUYQOBSRJR
INDSTOCKS_WATCHLIST=
MARKET_DATA_MAX_AGE_HOURS=36
# Stock-list picker liquidity floors (penny / illiquid names are excluded)
STOCK_PICK_MIN_MARKET_CAP_CR=5000
STOCK_PICK_MIN_AVG_VOLUME=100000
MARKET_AUTO_SYNC_ENABLED=true
MARKET_SYNC_INTERVAL_HOURS=6
LIVE_UNIVERSE_CONCURRENCY=8
LIVE_UNIVERSE_CALL_TIMEOUT_SECONDS=15
LIVE_UNIVERSE_WAIT_SECONDS=20
QUOTE_CACHE_TTL_SECONDS=120

# ------------------------------------------------------------------------------
# AMFI daily NAV file (no key). Scheme codes you want stored.
# ------------------------------------------------------------------------------
AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt
AMFI_SCHEME_CODES=
